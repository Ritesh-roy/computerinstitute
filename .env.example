# SK Institute Environment Configuration
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=production

# WhatsApp Integration (already configured in code)
# WHATSAPP_NUMBER=919971541416

# Optional: API Configuration (for future backend services)
# VITE_API_URL=https://api.sk-institute.com
# DATABASE_URL=mongodb://user:password@host/db (if database is added later)

# Optional: Tracking & Analytics
# VITE_GA_ID=UA-XXXXXXXXX-X
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Note: Only variables prefixed with VITE_ are exposed to the client.
# Server-only secrets should be added directly in environment.
